APP_ENV=development
APP_NAME=SSSA Employee Portal
LOG_LEVEL=INFO
API_DOCS_ENABLED=true

TENANT_ID=00000000-0000-0000-0000-000000000000
PORTAL_CLIENT_ID=00000000-0000-0000-0000-000000000000
PORTAL_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000

D365_CLIENT_ID=00000000-0000-0000-0000-000000000000
D365_CLIENT_SECRET=replace-me
D365_BASE_URL=https://sssa.operations.dynamics.com
D365_ODATA_URL=https://sssa.operations.dynamics.com/data
D365_TOKEN_AUTH_MODE=secret
D365_METADATA_MAX_BYTES=268435456

DATABASE_URL=postgresql+asyncpg://portal:change-me@postgres:5432/employee_portal
REDIS_URL=redis://redis:6379/0

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost,https://portal.example.internal
FRONTEND_URL=https://portal.example.internal
SESSION_SECRET=replace-with-at-least-32-random-characters

POSTGRES_DB=employee_portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me
